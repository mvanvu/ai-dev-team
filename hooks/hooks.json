{
  "description": "ai-dev-team leader guard: during a dev-team run the main session (the leader) does not change project files; agents do.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "-S", "${CLAUDE_PLUGIN_ROOT}/hooks/leader-guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
